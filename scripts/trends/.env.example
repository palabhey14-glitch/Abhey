# Copy to the repo root as .env (already git-ignored) and fill in.
# On GitHub Actions, add the same names under Settings > Secrets and variables > Actions.

# Required for YouTube. Google Cloud console > APIs & Services > enable
# "YouTube Data API v3" > Credentials > Create API key. Restrict it to that API.
YOUTUBE_API_KEY=

# Recommended for Reddit (required on GitHub Actions, where Reddit often blocks
# logged-out requests). https://www.reddit.com/prefs/apps > "create another app"
# > type "script" > redirect uri http://localhost. The id is under the app name.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
